# number pad

from tkinter import *

root = Tk()
root.title("Number Pad")

frame = Frame(root, bd=5, relief=RIDGE)
frame .pack(padx=20, pady=20)

buttons = [
    "7", "8", "9",
    "4", "5", "6",
    "1", "2", "3",
    "*", "0", "#"
]

k = 0

for i in range(4):
    for j in range(3):
        lbl = Label(
            frame,
            text=buttons[k],
            font=("Arial", 20),
            width=5,
            relief=RAISED,
            bd=3
        )
        lbl.grid(row=i, column=j, padx=5, pady=5)
        k += 1

root.mainloop()
