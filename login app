# LOgin Page

from tkinter import *
root = Tk()
root.title("Login Page")
root.geometry("300x200")
frame = Frame(root, bd=5, relief=RIDGE)
frame.pack(pady=20)

# Uername
Label(frame, text="Username:").grid(row=0, column=0, pady=10)
username_entry = Entry(frame)
username_entry.grid(row=0, column=1)

# Password
Label(frame, text="Password:").grid(row=1, column=0, pady=10)
password_entry = Entry(frame, show="*")
password_entry.grid(row=1, column=1)

# Message Label
message_label = Label(frame, text="")
message_label.grid(row=3, column=0, columnspan=2)

# Login Function
def login():
    username = username_entry.get()
    password = password_entry.get()
    if username == "admin" and password == "password":
        message_label.config(text="Login Successfully!", fg="green")
    else:
        message_label.config(text="Invalid Credentials", fg="red")

# Login Button
login_button = Button(frame, text="Login", command=login)
login_button.grid(row=2, column=0, columnspan=2, pady=10)
root.mainloop()
